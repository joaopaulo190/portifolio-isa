# Copie este arquivo para ".env" e ajuste os valores.

# Porta do servidor
PORT=3000

# Senha da área da personal (/admin). Use uma senha forte!
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Em produção (com HTTPS), deixe "true" para cookies seguros
COOKIE_SECURE=false

# Banco de dados na nuvem (Turso, gratuito). Deixe vazio para usar o arquivo local data/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
